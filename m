+#include <asm/io.h>
+#include <linux/bitfield.h>
+#include <linux/bitops.h>
+#include <linux/iopoll.h>
+
+#include "k3_ddr.h"
+
+#define K3_DDR_SARBASE(n)		(0x200c0 + (n) * 8)
+#define K3_DDR_SARSIZE(n)		(0x200c4 + (n) * 8)
+
+int k3_ddr_clock_init(struct k3_ddr *ddr, unsigned int channel)
+{
+	void __iomem *cfg = ddr->cfg[channel];
+	u32 value;
+	int ret;
+
+	setbits_le32(cfg + K3_DDR_CFG_PLL_SWCR2, K3_DDR_PLLA_SWCR2_OUT_EN | K3_DDR_PLLA_SWCR2_EN |
+						 K3_DDR_PLLA_SWCR2_MMD_EN);
+	ret = readl_poll_timeout(cfg + K3_DDR_CFG_PLL_STATUS, value, value & K3_DDR_CFG_PLL_LOCK,
+				 K3_DDR_REG_TIMEOUT_US);
+	if (ret)
+		return ret;
+
+	clrsetbits_le32(cfg + K3_DDR_CFG_CLK_CTRL, K3_DDR_CFG_CLK_SEL | K3_DDR_CFG_CLK_DIV,
+			FIELD_PREP(K3_DDR_CFG_CLK_SEL, 2));
+
+	setbits_le32(cfg + K3_DDR_CFG_CLK_CTRL, K3_DDR_CFG_CLK_FC);
+	ret = readl_poll_timeout(cfg + K3_DDR_CFG_CLK_CTRL, value, !(value & K3_DDR_CFG_CLK_FC),
+				 K3_DDR_REG_TIMEOUT_US);
+	if (ret)
+		return ret;
+
+	setbits_le32(cfg + K3_DDR_CFG_CLK_CTRL, K3_DDR_CFG_CLK_EN);
+
+	return 0;
+}
+
+void k3_ddr_start_sw_done(struct k3_ddr *ddr, unsigned int channel)
+{
+	writel(0, ddr->ctrl[channel] + K3_DDR_SWCTL);
+}
+
+int k3_ddr_wait_sw_done_ack(struct k3_ddr *ddr, unsigned int channel)
+{
+	void __iomem *ctrl = ddr->ctrl[channel];
+	u32 value;
+
+	writel(1, ctrl + K3_DDR_SWCTL);
+
+	return readl_poll_timeout(ctrl + K3_DDR_SWSTAT, value, value & BIT(0),
+				 K3_DDR_REG_TIMEOUT_US);
+}
+
+void k3_ddr_configure_sar(struct k3_ddr *ddr, unsigned int channel)
+{
+	void __iomem *ctrl = ddr->ctrl[channel];
+	u32 region_blocks;
+	int region;
+
+	/* Four equal SARs (System Address Regions), in units of 256 MiB. */
+	region_blocks = ddr->profile->part_size_mb / 4 / 256;
+
+	for (region = 0; region < 4; region++) {
+		writel(8 + region_blocks * region, ctrl + K3_DDR_SARBASE(region));
+		writel(region_blocks - 1, ctrl + K3_DDR_SARSIZE(region));
+	}
+}
