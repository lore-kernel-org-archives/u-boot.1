+#define  K3_DDR_PLLA_SWCR2_EN		BIT(16)
+#define  K3_DDR_PLLA_SWCR2_OUT_EN	GENMASK(7, 0)
+
+#define K3_DDR_CFG_PLL_STATUS		0x1c
+#define  K3_DDR_CFG_PLL_LOCK		BIT(0)
+
+#define K3_DDR_CFG_CLK_CTRL		0x18
+#define  K3_DDR_CFG_CLK_FC		BIT(25)
+#define  K3_DDR_CFG_CLK_SEL		GENMASK(21, 19)
+#define  K3_DDR_CFG_CLK_DIV		GENMASK(18, 16)
+#define  K3_DDR_CFG_CLK_EN		BIT(0)
+
+#define K3_DDR_PHY_CFG_OP		GENMASK(31, 24)
+#define K3_DDR_PHY_CFG_ADDR		GENMASK(23, 0)
+
+#define K3_DDR_PHY_CFG_SINGLE		0
+#define K3_DDR_PHY_CFG_RANGE		1
+
+#define K3_DDR_PHY_SKIP			BIT(0)
+
+struct k3_ddr_phy_cfg {
+	/* Bits [31:24] encode the operation. Bits [23:0] hold the PHY CSR address. */
+	u32 opaddr;
+	union {
+		u16 value;
+		struct {
+			const u16 *values;
+			u16 count;
+		} range;
+	};
+};
+
+#define K3_DDR_PHY_WRITE_SINGLE(_csr, _value)					\
+{										\
+	.opaddr	= (_csr) | (K3_DDR_PHY_CFG_SINGLE << 24),			\
+	.value	= (_value),							\
+}
+
+#define K3_DDR_PHY_WRITE_RANGE(_csr, _values)					\
+{										\
+	.opaddr	= (_csr) | (K3_DDR_PHY_CFG_RANGE << 24),			\
+	.range	= {								\
+		.values	= (_values),						\
+		.count	= ARRAY_SIZE(_values),					\
+	},									\
+}
