+/* BEGIN_CASE */
+void save_large_persistent_key(int data_length_arg, int expected_status)
+{
+    mbedtls_svc_key_id_t key_id =3D mbedtls_svc_key_id_make(1, 42);
+    uint8_t *data =3D NULL;
+    size_t data_length =3D data_length_arg;
+    psa_key_attributes_t attributes =3D PSA_KEY_ATTRIBUTES_INIT;
+
+    TEST_CALLOC(data, data_length);
+
+    PSA_ASSERT(psa_crypto_init());
+
+    psa_set_key_id(&attributes, key_id);
+    psa_set_key_type(&attributes, PSA_KEY_TYPE_RAW_DATA);
+
+    TEST_EQUAL(psa_import_key(&attributes, data, data_length, &key_id),
+               expected_status);
+
+    if (expected_status =3D=3D PSA_SUCCESS) {
+        PSA_ASSERT(psa_destroy_key(key_id));
+    }
+
+exit:
+    mbedtls_free(data);
+    PSA_DONE();
+    psa_destroy_persistent_key(key_id);
+}
+/* END_CASE */
