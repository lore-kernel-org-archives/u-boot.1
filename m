+static void r8157_hw_phy_cfg(struct r8152 *tp)
+{
+	int ret;
+
+	r8156b_wait_loading_flash(tp);
+
+	r8157_patch_code(tp);
+
+	ocp_word_test_and_clr_bits(tp, MCU_TYPE_USB, USB_MISC_0, PCUT_STATUS);
