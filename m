+static const u32 ddrphy_fsp_cfg[DDRPHY_QB_FSP_SIZE] = {
+	0x00054026, /* TrainedVREFDQ_A0,   Byte offset 0x4d,      CSR Addr 0x54026 */
+	0x00054027, /* TrainedVREFDQ_A1,   Byte offset 0x4e,      CSR Addr 0x54027 */
