-/*
- * This function stops the operation of the davinci usb module.
- */
-int usb_lowlevel_stop(int index)
-{
-	/* Reset the USB module */
-	musb_platform_deinit();
-	writeb(0, &musbr->devctl);
-	return 0;
-}
