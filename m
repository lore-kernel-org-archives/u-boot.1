+                                           (input_N->len > 0) ? input_N->x=
 : NULL, input_N->len,
+                                           NULL, 0, NULL, 0, NULL, 0, NULL=
, 0) =3D=3D 0);
+
+        TEST_ASSERT(mbedtls_rsa_import_raw(&ctx,
+                                           NULL, 0,
+                                           (input_P->len > 0) ? input_P->x=
 : NULL, input_P->len,
+                                           NULL, 0, NULL, 0, NULL, 0) =3D=
=3D 0);
+
+        TEST_ASSERT(mbedtls_rsa_import_raw(&ctx,
+                                           NULL, 0, NULL, 0,
+                                           (input_Q->len > 0) ? input_Q->x=
 : NULL, input_Q->len,
+                                           NULL, 0, NULL, 0) =3D=3D 0);
+
+        TEST_ASSERT(mbedtls_rsa_import_raw(&ctx,
+                                           NULL, 0, NULL, 0, NULL, 0,
+                                           (input_D->len > 0) ? input_D->x=
 : NULL, input_D->len,
+                                           NULL, 0) =3D=3D 0);
+
+        TEST_ASSERT(mbedtls_rsa_import_raw(&ctx,
+                                           NULL, 0, NULL, 0, NULL, 0, NULL=
, 0,
