+    psa_algorithm_t alg2 =3D alg2_arg;
+    psa_key_usage_t usage_flags =3D usage_arg;
+    psa_key_type_t type =3D type_arg;
+    invalidate_method_t invalidate_method =3D invalidate_method_arg;
+    mbedtls_svc_key_id_t returned_id =3D MBEDTLS_SVC_KEY_ID_INIT;
+    psa_key_handle_t handle =3D PSA_KEY_HANDLE_INIT;
+    psa_key_attributes_t attributes =3D PSA_KEY_ATTRIBUTES_INIT;
+    psa_key_attributes_t read_attributes =3D PSA_KEY_ATTRIBUTES_INIT;
+    uint8_t *reexported =3D NULL;
+    size_t reexported_length =3D -1;
+
+#if defined(MBEDTLS_PSA_CRYPTO_KEY_ID_ENCODES_OWNER)
+    mbedtls_svc_key_id_t wrong_owner_id =3D
+        mbedtls_svc_key_id_make(owner_id_arg + 1, id_arg);
+    mbedtls_svc_key_id_t invalid_svc_key_id =3D MBEDTLS_SVC_KEY_ID_INIT;
+#endif
+
+    TEST_USES_KEY_ID(id);
+
+    mbedtls_test_set_step(1);
