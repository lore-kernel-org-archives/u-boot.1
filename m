+                }
+            } else {
+                TEST_ASSERT(memcmp(buf, input->x, input->len) =3D=3D 0);
+                for (size_t i =3D input->len; i < nb; i++) {
+                    TEST_EQUAL(buf[i], 0);
+                }
+            }
+        } else {
+            if (endian =3D=3D MBEDTLS_MPI_MOD_EXT_REP_BE) {
+                size_t leading_zeroes =3D input->len - nb;
+                TEST_ASSERT(memcmp(input->x + input->len - nb, buf, nb) =
=3D=3D 0);
+                for (size_t i =3D 0; i < leading_zeroes; i++) {
+                    TEST_EQUAL(input->x[i], 0);
+                }
+            } else {
+                TEST_ASSERT(memcmp(input->x, buf, nb) =3D=3D 0);
