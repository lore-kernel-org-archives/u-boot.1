+#define SETUP_ALWAYS_CHECK_STEP(test_function, this_check_err_stage)      \
+    status =3D test_function;                                             =
    \
+    if (err_stage !=3D this_check_err_stage)                              =
   \
+    {                                                                     =
  \
+        PSA_ASSERT(status);                                               \
+    }                                                                     =
  \
+    else                                                                  =
  \
+    {                                                                     =
  \
+        TEST_EQUAL(status, expected_error);                               \
+        goto exit;                                                        =
  \
+    }
