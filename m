+        TEST_ASSERT(ret =3D=3D 0);
+
+        /* Compare results */
+        TEST_ASSERT(rec.type =3D=3D rec_backup.type);
+        TEST_ASSERT(memcmp(rec.ctr, rec_backup.ctr, 8) =3D=3D 0);
+        TEST_ASSERT(rec.ver[0] =3D=3D rec_backup.ver[0]);
+        TEST_ASSERT(rec.ver[1] =3D=3D rec_backup.ver[1]);
+        TEST_ASSERT(rec.data_len =3D=3D rec_backup.data_len);
+        TEST_ASSERT(rec.data_offset =3D=3D rec_backup.data_offset);
+        TEST_ASSERT(memcmp(rec.buf + rec.data_offset,
+                           rec_backup.buf + rec_backup.data_offset,
+                           rec.data_len) =3D=3D 0);
+    }
+
+exit:
+
+    /* Cleanup */
+    mbedtls_ssl_free(&ssl);
+    mbedtls_ssl_transform_free(&t0);
+    mbedtls_ssl_transform_free(&t1);
+
+    mbedtls_free(buf);
+    MD_OR_USE_PSA_DONE();
