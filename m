+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * Copyright (C) 2026 Junhui Liu <junhui.liu@pigmoral.tech>
+ */
+
+#include <binman_sym.h>
+#include <dm.h>
+#include <dm/device_compat.h>
+#include <dm/ofnode.h>
+#include <errno.h>
+#include <linux/sizes.h>
+#include <ram.h>
+#include <soc/spacemit/k3-ddr.h>
+#include <spl.h>
+
+#include "k3_ddr.h"
+
+struct k3_ddr_priv {
+	struct k3_ddr ddr;
+	struct ram_info info;
+};
+
+binman_sym_declare(ulong, u_boot_spl, image_pos);
+binman_sym_declare(ulong, lpddr5_imem, image_pos);
+binman_sym_declare(ulong, lpddr5_imem, size);
+
+static int k3_ddr_get_firmware(struct k3_ddr *ddr)
+{
+	ulong fw_pos = binman_sym(ulong, lpddr5_imem, image_pos);
+	ulong spl_pos = binman_sym(ulong, u_boot_spl, image_pos);
+	ulong size = binman_sym(ulong, lpddr5_imem, size);
+
+	if (!BINMAN_SYMS_OK)
+		return -ENOENT;
+
+	if (!size || size > K3_PHY_PMU_IMEM_SIZE * sizeof(u16))
+		return -EINVAL;
+
+	ddr->imem_fw = (const u8 *)(CONFIG_SPL_TEXT_BASE + fw_pos - spl_pos);
+	ddr->imem_fw_size = size;
+
+	return 0;
+}
+
+static int k3_ddr_get_info(struct udevice *dev, struct ram_info *info)
+{
+	struct k3_ddr_priv *priv = dev_get_priv(dev);
+
+	*info = priv->info;
+
+	return 0;
+}
+
+static int k3_ddr_probe(struct udevice *dev)
+{
+	struct k3_ddr_priv *priv = dev_get_priv(dev);
+	struct k3_ddr_plat *plat = dev_get_plat(dev);
+	const char *part_number = plat->part_number;
+	struct ofnode_phandle_args apmu_args;
+	fdt_addr_t addr;
+	int i, ret;
+
+	priv->ddr.dev = dev;
+
+	for (i = 0; i < K3_DDR_NUM_CHANNELS; i++) {
+		priv->ddr.ctrl[i] = dev_read_addr_index_ptr(dev, i);
+		if (!priv->ddr.ctrl[i])
+			return -EINVAL;
+
+		priv->ddr.cfg[i] = priv->ddr.ctrl[i] + K3_DDR_CFG_OFFSET;
+		priv->ddr.phy[i] = priv->ddr.ctrl[i] + K3_DDR_PHY_OFFSET;
+	}
+
+	ret = dev_read_phandle_with_args(dev, "spacemit,apmu", NULL, 1, 0, &apmu_args);
+	if (ret)
+		return ret;
+
+	addr = ofnode_get_addr(apmu_args.node);
+	if (addr == FDT_ADDR_T_NONE)
+		return -EINVAL;
+
+	priv->ddr.apmu = (void __iomem *)addr;
+	priv->ddr.apmu_offset = apmu_args.args[0];
+
+	if (!part_number[0]) {
+		dev_err(dev, "DDR part number not configured\n");
+		return -EINVAL;
+	}
+
+	priv->ddr.profile = k3_ddr_find_profile(part_number);
+	if (!priv->ddr.profile) {
+		dev_err(dev, "unsupported DDR part: %s\n", part_number);
+		return -EOPNOTSUPP;
+	}
+
+	ret = k3_ddr_get_firmware(&priv->ddr);
+	if (ret) {
+		dev_err(dev, "invalid or missing DDR PMU firmware: %d\n", ret);
+		return ret;
+	}
+
+	debug("DDR: %s, %u MiB/channel, %u ranks, x%u\n", part_number,
+	      priv->ddr.profile->part_size_mb, priv->ddr.profile->ranks,
+	      priv->ddr.profile->device_width);
+
+	ret = k3_ddr_lpddr5_init(&priv->ddr);
+	if (ret)
+		return ret;
+
+	priv->info.base = 0x100000000ULL;
+	priv->info.size = (phys_size_t)priv->ddr.profile->part_size_mb *
+			  K3_DDR_NUM_CHANNELS * SZ_1M;
+
+	return 0;
+}
+
+static const struct ram_ops k3_ddr_ops = {
+	.get_info = k3_ddr_get_info,
+};
+
+static const struct udevice_id k3_ddr_ids[] = {
+	{ .compatible = "spacemit,k3-ddrc" },
+	{ /* sentinel */ }
+};
+
+U_BOOT_DRIVER(spacemit_k3_ddr) = {
+	.name = "spacemit_k3_ddr",
+	.id = UCLASS_RAM,
+	.of_match = k3_ddr_ids,
+	.probe = k3_ddr_probe,
+	.ops = &k3_ddr_ops,
+	.priv_auto = sizeof(struct k3_ddr_priv),
+	.plat_auto = sizeof(struct k3_ddr_plat),
+};
