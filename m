+static int k3_lpddr5_configure_addrmap(struct k3_ddr *ddr, unsigned int channel)
+{
+	const struct k3_ddr_profile *profile = ddr->profile;
+	void __iomem *ctrl = ddr->ctrl[channel];
+	u32 cs_map, addrmap7;
+	u32 addrmap12 = 0;
+
+	switch (profile->part_size_mb) {
+	case SZ_4G / SZ_1M:
+		cs_map = 0x0000003f;
+		addrmap7 = 0x1f1f0808;
+		break;
+	case SZ_8G / SZ_1M:
+		cs_map = 0x00000018;
+		addrmap7 = 0x1f1f0808;
+		break;
+	case (SZ_8G + SZ_4G) / SZ_1M:
+		cs_map = 0x00000019;
+		addrmap7 = 0x1f080808;
+		/* Exclude the unused quarter of the 16 GiB address range. */
+		addrmap12 = 0x00000004;
+		break;
+	case SZ_16G / SZ_1M:
+		cs_map = 0x00000019;
+		addrmap7 = 0x1f080808;
+		break;
+	default:
+		return -EOPNOTSUPP;
+	}
+
+	writel(cs_map, ctrl + K3_DDR_ADDRMAP(1));
+	writel(0x003f0903, ctrl + K3_DDR_ADDRMAP(3));
+	writel(0x00000101, ctrl + K3_DDR_ADDRMAP(4));
+	writel(0x1f030303, ctrl + K3_DDR_ADDRMAP(5));
+	writel(0x03030300, ctrl + K3_DDR_ADDRMAP(6));
+	writel(addrmap7, ctrl + K3_DDR_ADDRMAP(7));
+	writel(0x08080808, ctrl + K3_DDR_ADDRMAP(8));
+	writel(0x08080808, ctrl + K3_DDR_ADDRMAP(9));
+	writel(0x08080808, ctrl + K3_DDR_ADDRMAP(10));
+	writel(0x00000808, ctrl + K3_DDR_ADDRMAP(11));
+	writel(addrmap12, ctrl + K3_DDR_ADDRMAP(12));
+
+	return 0;
+}
