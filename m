+
+#ifndef _SPACEMIT_K3_DDR_H_
+#define _SPACEMIT_K3_DDR_H_
+
+#include <linux/bitops.h>
+#include <linux/kernel.h>
+#include <linux/types.h>
+
+#define K3_DDR_NUM_CHANNELS		2
+#define K3_DDR_REG_TIMEOUT_US		100000
+
+/* PHY PMU memory bases and sizes are in 16-bit CSR words. */
+#define K3_PHY_PMU_IMEM_BASE		0x50000
+#define K3_PHY_PMU_IMEM_SIZE		0x8000
+#define K3_PHY_PMU_DMEM_BASE		0x58000
+#define K3_PHY_PMU_DMEM_SIZE		0x8000
+
+#define K3_DDR_PHY_OFFSET		0x800000
+#define K3_DDR_CFG_OFFSET		0x600000
+
+#define K3_DDR_SWCTL			0x10c80
+#define K3_DDR_SWSTAT			0x10c84
+#define K3_DDR_PWRCTL			0x10180
