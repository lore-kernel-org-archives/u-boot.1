+	int ret;
+
+	writel(0x00000002, ctrl + K3_DDR_OPCTRL1);
+	writel(0xc0020002, ctrl + K3_DDR_INITTMG0);
+	writel(0x00000811, ctrl + K3_DDR_PWRCTL);
+	writel(0x00000800, ctrl + K3_DDR_PWRCTL);
+	writel(0x00000001, ctrl + K3_DDR_RFSHCTL0);
+
+	setbits_le32(ddr->cfg[channel] + K3_DDR_CFG_CLK_CTRL, BIT(22));
+	setbits_le32(ddr->cfg[channel] + K3_DDR_CFG_CLK_CTRL, BIT(1));
+
+	writel(0x80000000, ctrl + K3_DDR_ZQCTL0);
+	writel(0xc000012c, ctrl + 0x000005b4);
+
+	k3_ddr_start_sw_done(ddr, channel);
+	writel(0x00000001, ctrl + K3_DDR_ZQCTL2);
+	ret = k3_ddr_wait_sw_done_ack(ddr, channel);
+	if (ret)
+		return ret;
+
+	k3_ddr_start_sw_done(ddr, channel);
+	writel(0x00010014, ctrl + K3_DDR_DFIMISC);
+	ret = k3_ddr_wait_sw_done_ack(ddr, channel);
+	if (ret)
+		return ret;
+
+	writel(0x00000000, ctrl + K3_DDR_RFSHCTL0);
+
+	return 0;
+}
+
+static int k3_lpddr5_ctrl_init(struct k3_ddr *ddr, unsigned int channel)
+{
+	int ret;
+
+	ret = k3_ddr_clock_init(ddr, channel);
+	if (ret)
+		return ret;
+
+	k3_lpddr5_configure_controller(ddr, channel);
+	k3_lpddr5_configure_parameters(ddr, channel);
+	k3_lpddr5_configure_ports(ddr, channel);
+	k3_ddr_configure_sar(ddr, channel);
+
+	ret = k3_lpddr5_configure_addrmap(ddr, channel);
+	if (ret)
+		return ret;
+
+	return k3_lpddr5_controller_pre_train(ddr, channel);
+}
+
+static u16 k3_lpddr5_phy_io_value(bool x8, u32 csr, u16 value)
+{
+	const struct k3_ddr_io_para *io = &k3_ddr_lpddr5_io_para;
+	u32 reg_offset = csr & 0xfff;
+	u32 reg_base = csr & ~0xfff;
+
+	if (reg_base >= 0x10000 && reg_base <= 0x13000) {
+		switch (reg_offset) {
+		case 0x40:
+		case 0x42:
+		case 0x43:
+		case 0x44:
+		case 0x45:
+			return io->write_ds | (io->write_ds << 8);
+		}
+	}
+
+	if ((reg_base == 0x30000 || reg_base == 0x31000) &&
+	    reg_offset >= 0x40 && reg_offset <= 0x43)
+		return io->write_ds | (io->write_ds << 8);
+
+	if (reg_base >= 0x10000 && reg_base <= 0x13000) {
+		switch (reg_offset) {
+		case 0x48:
+		case 0x4a:
+		case 0x4b:
+		case 0x4c:
+		case 0x4d:
+			return io->rx_odt << 8;
+		}
+	}
+
+	if (csr == K3_PHY_MB_MR3 || csr == K3_PHY_MB_MR3 + 1)
+		return io->pdds | (io->pdds << 8);
+
+	if (csr == K3_PHY_MB_MR11 || csr == K3_PHY_MB_MR11 + 1) {
+		value = io->dq_odt | (io->ca_odt << 4);
+		value |= (io->nt_odt != K3_DDR_R_OFF) << 3;
+		return value | (value << 8);
+	}
+
+	if (csr == K3_PHY_MB_MR17 || csr == K3_PHY_MB_MR17 + 1) {
+		value = BIT(3) | BIT(5);
+		value |= io->soc_odt | (io->soc_odt << 8);
+		value |= (x8 << 7) | (x8 << 15);
+		return value;
+	}
+
+	if (csr == K3_PHY_MB_MR41 || csr == K3_PHY_MB_MR41 + 1) {
+		value = io->nt_odt << 5;
+		return value | (value << 8);
+	}
+
+	/* Always enable 2D training (0) for supported LPDDR5 profiles. */
+	if (csr == K3_PHY_MB_DISABLE_2D)
+		return 0;
+
+	return value;
+}
+
+static void k3_lpddr5_phy_write_cfg(struct k3_ddr *ddr, unsigned int channel,
+				    const struct k3_ddr_phy_table *table,
+				    const struct k3_ddr_phy_overrides *overrides)
+{
+	const struct k3_ddr_phy_override *regs = overrides->regs;
+	bool x8 = ddr->profile->device_width == 8;
+	const struct k3_ddr_phy_cfg *cfg;
+	const u16 *values;
+	u32 base, csr;
+	int i, j, k;
+	int count;
+	u16 value;
+
+	for (i = 0; i < table->count; i++) {
+		cfg = &table->cfg[i];
+		base = FIELD_GET(K3_DDR_PHY_CFG_ADDR, cfg->opaddr);
+
+		if (FIELD_GET(K3_DDR_PHY_CFG_OP, cfg->opaddr) == K3_DDR_PHY_CFG_RANGE) {
+			values = cfg->range.values;
+			count = cfg->range.count;
+		} else {
+			values = &cfg->value;
+			count = 1;
+		}
+
+		for (j = 0; j < count; j++) {
+			value = values[j];
+			csr = base + j;
+
+			for (k = 0; k < overrides->count; k++) {
+				if (regs[k].csr == csr)
+					break;
+			}
+
+			if (k < overrides->count) {
+				if (regs[k].flags & K3_DDR_PHY_SKIP)
+					continue;
+
+				value = regs[k].value;
+			}
+
+			value = k3_lpddr5_phy_io_value(x8, csr, value);
+
+			k3_phy_write(ddr, channel, csr, value);
+		}
+	}
+}
+
+static int k3_lpddr5_phy_train(struct k3_ddr *ddr, unsigned int channel)
+{
+	const struct k3_ddr_profile *profile = ddr->profile;
+	struct k3_ddr_phy_overrides post = {};
+	struct k3_ddr_phy_overrides pre = {};
+	int ret;
+
+	if (profile->device_width == 16) {
+		if (profile->ranks == 1) {
+			pre = k3_ddr_lpddr5_pre_srank_x16_overrides;
+			post = k3_ddr_lpddr5_post_srank_x16_overrides;
+		} else {
+			pre = k3_ddr_lpddr5_pre_drank_x16_overrides;
+			post = k3_ddr_lpddr5_post_drank_x16_overrides;
+		}
+	}
+
+	k3_lpddr5_phy_write_cfg(ddr, channel, &k3_ddr_lpddr5_phy_init_table, &pre);
+
+	ret = k3_ddr_phy_load_imem(ddr, channel);
+	if (ret)
+		return ret;
+
+	k3_ddr_phy_zero_dmem(ddr, channel);
+	k3_lpddr5_phy_write_cfg(ddr, channel, &k3_ddr_lpddr5_pre_train_table, &pre);
+
+	setbits_le32(ddr->ctrl[channel] + K3_DDR_PWRCTL, BIT(11));
+
+	k3_ddr_phy_start_pmu(ddr, channel);
+	ret = k3_ddr_phy_wait_training(ddr, channel);
+	k3_ddr_phy_halt_pmu(ddr, channel);
+	if (ret)
+		return ret;
+
+	k3_lpddr5_phy_write_cfg(ddr, channel, &k3_ddr_lpddr5_post_train_table, &post);
+
+	return 0;
+}
+
+static int k3_lpddr5_ctrl_enable(struct k3_ddr *ddr, unsigned int channel)
+{
+	void __iomem *ctrl = ddr->ctrl[channel];
+	int port, ret;
+	u32 value;
+
+	k3_ddr_start_sw_done(ddr, channel);
+	writel(0x00010034, ctrl + K3_DDR_DFIMISC);
+	ret = k3_ddr_wait_sw_done_ack(ddr, channel);
+	if (ret)
+		return ret;
+
+	ret = readl_poll_timeout(ctrl + K3_DDR_DFISTAT, value, value & BIT(0),
+				 K3_DDR_REG_TIMEOUT_US);
+	if (ret)
+		return ret;
+
+	k3_ddr_start_sw_done(ddr, channel);
+	writel(0x00010015, ctrl + K3_DDR_DFIMISC);
+	ret = k3_ddr_wait_sw_done_ack(ddr, channel);
+	if (ret)
+		return ret;
+
+	writel(0, ctrl + K3_DDR_PWRCTL);
+
+	ret = readl_poll_timeout(ctrl + K3_DDR_STAT, value, (value & GENMASK(1, 0)) == 1,
+				 K3_DDR_REG_TIMEOUT_US);
+	if (ret)
+		return ret;
+
+	k3_ddr_start_sw_done(ddr, channel);
+	writel(0xc0000000, ctrl + K3_DDR_DFIUPD0);
+	ret = k3_ddr_wait_sw_done_ack(ddr, channel);
+	if (ret)
+		return ret;
+
+	writel(0, ctrl + K3_DDR_ZQCTL0);
+
+	k3_ddr_start_sw_done(ddr, channel);
+	writel(0, ctrl + K3_DDR_ZQCTL2);
+	ret = k3_ddr_wait_sw_done_ack(ddr, channel);
+	if (ret)
+		return ret;
+
+	writel(0, ctrl + K3_DDR_RFSHCTL0);
+	writel(0x10, ctrl + K3_DDR_PWRCTL);
+	writel(0xe000012c, ctrl + 0x5b4);
+	writel(0, ctrl + K3_DDR_OPCTRL1);
+
+	for (port = 0; port < 5; port++)
+		writel(1, ctrl + 0x20090 + port * 0x1000);
+
+	return 0;
+}
+
+int k3_ddr_lpddr5_init(struct k3_ddr *ddr)
+{
+	unsigned int channel;
+	int ret;
+
+	for (channel = 0; channel < K3_DDR_NUM_CHANNELS; channel++) {
+		ret = k3_lpddr5_ctrl_init(ddr, channel);
+		if (ret) {
+			dev_err(ddr->dev, "channel %u controller init failed: %d\n", channel, ret);
+			return ret;
+		}
+
+		ret = k3_lpddr5_phy_train(ddr, channel);
+		if (ret) {
+			dev_err(ddr->dev, "channel %u PHY training failed: %d\n", channel, ret);
+			return ret;
+		}
+
+		ret = k3_lpddr5_ctrl_enable(ddr, channel);
+		if (ret) {
+			dev_err(ddr->dev, "channel %u controller enable failed: %d\n",
+				channel, ret);
+			return ret;
+		}
+	}
+
+	return 0;
+}
