+
+const struct k3_ddr_profile *k3_ddr_find_profile(const char *part_number)
+{
+	int i;
+
+	if (!part_number || !*part_number)
+		return NULL;
+
+	for (i = 0; i < ARRAY_SIZE(k3_ddr_profiles); i++) {
+		const struct k3_ddr_profile *profile = &k3_ddr_profiles[i];
+
+		if (!strcmp(part_number, profile->part_number))
+			return &k3_ddr_profiles[i];
+	}
+
+	return NULL;
+}
