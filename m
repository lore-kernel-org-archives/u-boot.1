sandbox_spl enables CONFIG_SPL_ZSTD so that link errors show up, but no
test feeds a zstd payload through load_simple_fit(), so the decoder
itself never runs.

Add FIT_INTERNAL_ZSTD and FIT_EXTERNAL_ZSTD next to the LZMA pair and
register them for the NOR loader the same way. do_spl_test_load() picks
the canned blob by compression name instead of assuming LZMA. The plain
payload was already seeded with that name.

image_supported() gives the new pair its own return instead of joining
the LZMA fallthrough, so the LZMA tests do not start depending on
CONFIG_SPL_ZSTD.

The blob is generate_data() output for the seed "zstd", compressed with
the same arguments binman's zstd bintool uses:

  zstd --compress --stdout plain.bin    (zstd v1.5.7)

Signed-off-by: Cole Munz <Munzzyy1@proton.me>
---
 include/test/spl.h        |  10 +
 test/image/spl_load.c     | 403 +++++++++++++++++++++++++++++++++++++-
 test/image/spl_load_nor.c |   2 +
 3 files changed, 405 insertions(+), 10 deletions(-)

diff --git a/include/test/spl.h b/include/test/spl.h
index ce0e636d2537..4f66c2da9823 100644
--- a/include/test/spl.h
+++ b/include/test/spl.h
@@ -31,8 +31,10 @@ void generate_data(char *data, size_t size, const char *=
test_name);
  * @IMX8: i.MX8 Container images
  * @FIT_INTERNAL: FITs with internal data
  * @FIT_INTERNAL_LZMA: FITs with internal data, LZMA compressed
+ * @FIT_INTERNAL_ZSTD: FITs with internal data, Zstandard compressed
  * @FIT_EXTERNAL: FITs with external data
  * @FIT_EXTERNAL_LZMA: FITs with external data, LZMA compressed
+ * @FIT_EXTERNAL_ZSTD: FITs with external data, Zstandard compressed
  */
 enum spl_test_image {
 =09LEGACY,
@@ -40,8 +42,10 @@ enum spl_test_image {
 =09IMX8,
 =09FIT_INTERNAL,
 =09FIT_INTERNAL_LZMA,
+=09FIT_INTERNAL_ZSTD,
 =09FIT_EXTERNAL,
 =09FIT_EXTERNAL_LZMA,
+=09FIT_EXTERNAL_ZSTD,
 };
=20
 /**
@@ -88,6 +92,8 @@ int check_image_info(struct unit_test_state *uts, struct =
spl_image_info *info1,
 /* Some compressed data and it size */
 extern const char lzma_compressed[];
 extern const size_t lzma_compressed_size;
+extern const char zstd_compressed[];
+extern const size_t zstd_compressed_size;
=20
 /**
  * typedef write_image_t - Callback for writing an image
@@ -135,6 +141,10 @@ static inline bool image_supported(enum spl_test_image=
 type)
 =09=09return IS_ENABLED(CONFIG_SPL_LEGACY_IMAGE_FORMAT);
 =09case IMX8:
 =09=09return IS_ENABLED(CONFIG_SPL_LOAD_IMX_CONTAINER);
+=09case FIT_INTERNAL_ZSTD:
+=09case FIT_EXTERNAL_ZSTD:
+=09=09return IS_ENABLED(CONFIG_SPL_ZSTD) &&
+=09=09       IS_ENABLED(CONFIG_SPL_LOAD_FIT);
 =09case FIT_INTERNAL_LZMA:
 =09case FIT_EXTERNAL_LZMA:
 =09=09if (!IS_ENABLED(CONFIG_SPL_LZMA))
