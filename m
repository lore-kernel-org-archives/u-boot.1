-
-	ldr		r2, [r1, #0xC]
-	str		r2, [r1, #0x10]
-
-	ldr		r0, =MERAM_BASE
-	ldr		r2, [r0]
-	cmp		r2, #0
-	movne	pc, r2
-
-	b		wait_loop
-
-wait_loop_end:
-	.pool
-	.align 4
-
-lowlevel_init__:
