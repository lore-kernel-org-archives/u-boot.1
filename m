+    MD_OR_USE_PSA_INIT();
+
+    ret =3D mbedtls_test_ssl_build_transforms(&t0, &t1, cipher_type, hash_=
id,
+                                            etm, tag_mode, ver,
+                                            (size_t) cid0_len,
+                                            (size_t) cid1_len);
+
+    TEST_ASSERT(ret =3D=3D 0);
+
+    TEST_CALLOC(buf, buflen);
+
