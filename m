+    TEST_COMPARE_MPI_RESIDUES(x, d);
+
+    /* a - b: alias x to b =3D> Correct result */
+    memcpy(x.p, b.p, bytes);
+    TEST_EQUAL(0, mbedtls_mpi_mod_sub(&x, &a, &x, &m));
+    TEST_COMPARE_MPI_RESIDUES(x, d);
+
+    if (memcmp(a.p, b.p, bytes) =3D=3D 0) {
