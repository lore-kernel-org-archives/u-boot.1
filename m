+     * This should not reach mbedtls_ssl_decrypt_buf() as used in the libr=
ary,
+     * so the exact error doesn't matter, but we don't want a crash. */
+    {
+        const uint8_t buf1[1] =3D { 'a' };
+        rec =3D rec_good;
+        /* We won't write to buf1[0] since it's out of range, so we can ca=
st
+         * the const away. */
+        rec.buf =3D (uint8_t *) buf1;
+        rec.buf_len =3D 0;
+        TEST_EQUAL(mbedtls_ssl_decrypt_buf(&ssl, &transform_in, &rec),
+                   MBEDTLS_ERR_SSL_INTERNAL_ERROR);
+    }
+    rec =3D rec_good;
+    rec.buf =3D NULL;
+    rec.buf_len =3D 0;
+    TEST_EQUAL(mbedtls_ssl_decrypt_buf(&ssl, &transform_in, &rec),
+               MBEDTLS_ERR_SSL_INTERNAL_ERROR);
+
+exit:
+    mbedtls_ssl_transform_free(&transform_in);
+    mbedtls_ssl_transform_free(&transform_out);
+    mbedtls_free(rec_good.buf);
+    mbedtls_ssl_free(&ssl);
+    mbedtls_free(buf);
+    MD_OR_USE_PSA_DONE();
