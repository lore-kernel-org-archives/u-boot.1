+    if (is_accelerated_rsa(alg) &&
+        (hash_alg =3D=3D PSA_ALG_RIPEMD160 || hash_alg =3D=3D PSA_ALG_SHA_=
384)) {
+        return 0;
+    }
+#endif /* MBEDTLS_TEST_LIBTESTDRIVER1 */
+
+    (void) key_type;
+    (void) alg;
+    (void) hash_alg;
+    (void) usage;
+    return 1;
+}
