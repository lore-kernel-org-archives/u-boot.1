+        buf_enc  =3D mbedtls_calloc(1, mbedtls_rsa_get_len(&ctx));
+        buf_dec  =3D mbedtls_calloc(1, mbedtls_rsa_get_len(&ctx));
+        if (buf_orig =3D=3D NULL || buf_enc =3D=3D NULL || buf_dec =3D=3D =
NULL) {
