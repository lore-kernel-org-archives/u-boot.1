 : NULL, input_P->len,
+                                           (input_Q->len > 0) ? input_Q->x=
 : NULL, input_Q->len,
+                                           (input_D->len > 0) ? input_D->x=
 : NULL, input_D->len,
+                                           (input_E->len > 0) ? input_E->x=
 : NULL,
+                                           input_E->len) =3D=3D 0);
+    } else {
