+                  char *input_X, int carry)
+{
+    mbedtls_mpi A, B, X;
+    mbedtls_mpi_uint *a =3D NULL;
+    mbedtls_mpi_uint *b =3D NULL;
+    mbedtls_mpi_uint *x =3D NULL; /* expected */
+    mbedtls_mpi_uint *r =3D NULL; /* result */
+
+    mbedtls_mpi_init(&A);
+    mbedtls_mpi_init(&B);
+    mbedtls_mpi_init(&X);
+
+    TEST_EQUAL(0, mbedtls_test_read_mpi(&A, input_A));
+    TEST_EQUAL(0, mbedtls_test_read_mpi(&B, input_B));
+    TEST_EQUAL(0, mbedtls_test_read_mpi(&X, input_X));
+
+    /* All of the inputs are +ve (or zero) */
+    TEST_EQUAL(1, A.s);
+    TEST_EQUAL(1, B.s);
+    TEST_EQUAL(1, X.s);
+
+    /* Get the number of limbs we will need */
+    size_t limbs =3D MAX(A.n, B.n);
+    size_t bytes =3D limbs * sizeof(mbedtls_mpi_uint);
+
+    /* The result shouldn't have more limbs than the longest input */
+    TEST_LE_U(X.n, limbs);
+
+    /* Now let's get arrays of mbedtls_mpi_uints, rather than MPI structur=
es */
+
+    /* TEST_CALLOC() uses calloc() under the hood, so these do get zeroed =
*/
+    TEST_CALLOC(a, bytes);
+    TEST_CALLOC(b, bytes);
+    TEST_CALLOC(x, bytes);
+    TEST_CALLOC(r, bytes);
+
+    /* Populate the arrays. As the mbedtls_mpi_uint[]s in mbedtls_mpis (an=
d as
+     * processed by mbedtls_mpi_core_sub()) are little endian, we can just
+     * copy what we have as long as MSBs are 0 (which they are from TEST_C=
ALLOC())
+     */
+    memcpy(a, A.p, A.n * sizeof(mbedtls_mpi_uint));
+    memcpy(b, B.p, B.n * sizeof(mbedtls_mpi_uint));
+    memcpy(x, X.p, X.n * sizeof(mbedtls_mpi_uint));
+
+    /* 1a) r =3D a - b =3D> we should get the correct carry */
+    TEST_EQUAL(carry, mbedtls_mpi_core_sub(r, a, b, limbs));
+
+    /* 1b) r =3D a - b =3D> we should get the correct result */
+    TEST_MEMORY_COMPARE(r, bytes, x, bytes);
+
+    /* 2 and 3 test "r may be aliased to a or b" */
+    /* 2a) r =3D a; r -=3D b =3D> we should get the correct carry (use r t=
o avoid clobbering a) */
+    memcpy(r, a, bytes);
+    TEST_EQUAL(carry, mbedtls_mpi_core_sub(r, r, b, limbs));
+
+    /* 2b) r -=3D b =3D> we should get the correct result */
+    TEST_MEMORY_COMPARE(r, bytes, x, bytes);
+
+    /* 3a) r =3D b; r =3D a - r =3D> we should get the correct carry (use =
r to avoid clobbering b) */
+    memcpy(r, b, bytes);
+    TEST_EQUAL(carry, mbedtls_mpi_core_sub(r, a, r, limbs));
+
+    /* 3b) r =3D a - b =3D> we should get the correct result */
+    TEST_MEMORY_COMPARE(r, bytes, x, bytes);
+
+    /* 4 tests "r may be aliased to [...] both" */
+    if (A.n =3D=3D B.n && memcmp(A.p, B.p, bytes) =3D=3D 0) {
