-		return ret;
-	gpio_direction_input(CFG_SYS_NAND_READY_PIN);
-
-	/* Enable NandFlash */
-	ret = gpio_request(CFG_SYS_NAND_ENABLE_PIN, "nand_ce");
-	if (ret)
-		return ret;
-	gpio_direction_output(CFG_SYS_NAND_ENABLE_PIN, 1);
-
-	return 0;
-}
