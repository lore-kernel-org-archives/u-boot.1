-	flags = AT91_SMC_MODE_DBW_16;
-#else
-	flags = AT91_SMC_MODE_DBW_8;
-#endif
-	writel(AT91_SMC_MODE_RM_NRD | AT91_SMC_MODE_WM_NWE |
-	       AT91_SMC_MODE_EXNW_DISABLE |
-	       flags |
-	       AT91_SMC_MODE_TDF_CYCLE(3),
-	       &smc->cs[3].mode);
