-		csr |= MUSB_CSR0_TXPKTRDY;
-		csr |= MUSB_CSR0_H_DIS_PING;
-		writew(csr, &musbr->txcsr);
-		result = wait_until_ep0_ready(dev, MUSB_CSR0_TXPKTRDY);
-		if (result < 0)
-			break;
-
-		txlen += nextlen;
-		dev->act_len = txlen;
-	}
-	return result;
-}
