+            TEST_CALLOC(X_raw, limbs - 1);
+
+            x.p =3D X_raw;
+            x.limbs =3D limbs - 1;
+            TEST_EQUAL(MBEDTLS_ERR_MPI_BAD_INPUT_DATA,
+                       mbedtls_mpi_mod_sub(&x, &a, &b, &m));
+
+            mbedtls_free(X_raw);
+            X_raw =3D NULL;
