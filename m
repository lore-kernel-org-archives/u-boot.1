-static __inline__ unsigned long
-log2 (unsigned long word)
-{
-#ifdef __I386__
-  __asm__ ("bsfl %1,%0"
-	   : "=r" (word)
-	   : "r" (word));
-  return word;
-#else
-  int i;
-
-  for(i=0; i<(8*sizeof(word)); i++)
-    if ((1<<i) & word)
-      return i;
-
-  return 0;
-#endif
-}
