+static s8_t
+com_udpc(struct command *com)
+{
+  ip_addr_t ipaddr;
+  u16_t lport, rport;
+  int i;
+  err_t err;
+  long tmp;
+
+  tmp = strtol(com->args[0], NULL, 10);
+  if((tmp < 0) || (tmp > 0xffff)) {
+    sendstr("Invalid port number."NEWLINE, com->conn);
+    return ESUCCESS;
