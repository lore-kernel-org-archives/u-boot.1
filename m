+
+#include <asm/io.h>
+#include <errno.h>
+#include <linux/iopoll.h>
+
+#include "k3_ddr.h"
+
+#define K3_PHY_MICRO_MUX_SEL		0xd0000
+#define K3_PHY_MICRO_RESET		0xd0099
+
+#define K3_PHY_UCT_SHADOW_REGS		0xd0004
+#define  K3_PHY_UCT_EMPTY		BIT(0)
+#define K3_PHY_DCT_WRITE_PROT		0xd0031
+#define K3_PHY_UCT_WRITE_ONLY_SHADOW	0xd0032
+
+#define K3_PHY_MSG_STREAM		0x08
+#define K3_PHY_MSG_COMPLETE		0x07
+#define K3_PHY_MSG_ERROR		0xff
+
+#define K3_PHY_MSG_TIMEOUT_US		10000000
+
+void k3_phy_write(struct k3_ddr *ddr, unsigned int channel, u32 csr, u16 value)
+{
+	writel(value, ddr->phy[channel] + csr * sizeof(u32));
+}
+
+static u16 k3_phy_read(struct k3_ddr *ddr, unsigned int channel, u32 csr)
+{
+	return readl(ddr->phy[channel] + csr * sizeof(u32));
+}
+
+int k3_ddr_phy_load_imem(struct k3_ddr *ddr, unsigned int channel)
+{
+	const u16 *firmware = (const u16 *)ddr->imem_fw;
+	size_t words;
+	int i;
+
+	if (channel >= K3_DDR_NUM_CHANNELS || !firmware || ddr->imem_fw_size % sizeof(u16))
+		return -EINVAL;
+
+	words = ddr->imem_fw_size / sizeof(u16);
+
+	for (i = 0; i < words; i++)
+		k3_phy_write(ddr, channel, K3_PHY_PMU_IMEM_BASE + i, le16_to_cpu(firmware[i]));
+
+	return 0;
+}
+
+void k3_ddr_phy_zero_dmem(struct k3_ddr *ddr, unsigned int channel)
+{
+	u32 csr;
+
+	k3_phy_write(ddr, channel, K3_PHY_MICRO_MUX_SEL, 0);
+
+	for (csr = K3_PHY_PMU_DMEM_BASE; csr < K3_PHY_PMU_DMEM_BASE + K3_PHY_PMU_DMEM_SIZE; csr++)
+		k3_phy_write(ddr, channel, csr, 0);
+}
+
+void k3_ddr_phy_start_pmu(struct k3_ddr *ddr, unsigned int channel)
+{
+	k3_phy_write(ddr, channel, K3_PHY_MICRO_MUX_SEL, 1);
+
+	k3_phy_write(ddr, channel, K3_PHY_MICRO_RESET, 9);
+	k3_phy_write(ddr, channel, K3_PHY_MICRO_RESET, 1);
+	k3_phy_write(ddr, channel, K3_PHY_MICRO_RESET, 0);
+}
+
+void k3_ddr_phy_halt_pmu(struct k3_ddr *ddr, unsigned int channel)
+{
+	k3_phy_write(ddr, channel, K3_PHY_MICRO_RESET, 1);
+
+	k3_phy_write(ddr, channel, K3_PHY_MICRO_MUX_SEL, 0);
+}
+
+static int k3_phy_wait_mailbox(struct k3_ddr *ddr, unsigned int channel, bool empty)
+{
+	u16 value;
+
+	return read_poll_timeout(k3_phy_read, value, !!(value & K3_PHY_UCT_EMPTY) == empty,
+				 1, K3_PHY_MSG_TIMEOUT_US, ddr, channel, K3_PHY_UCT_SHADOW_REGS);
+}
+
+static int k3_phy_ack_message(struct k3_ddr *ddr, unsigned int channel)
+{
+	int ret;
+
+	k3_phy_write(ddr, channel, K3_PHY_DCT_WRITE_PROT, 0);
+
+	ret = k3_phy_wait_mailbox(ddr, channel, true);
+	if (ret)
+		return ret;
+
+	k3_phy_write(ddr, channel, K3_PHY_DCT_WRITE_PROT, 1);
+
+	return 0;
+}
+
+int k3_ddr_phy_wait_training(struct k3_ddr *ddr, unsigned int channel)
+{
+	u8 message_id;
+	u16 message;
+	int i, ret;
+	u16 count;
+
+	if (channel >= K3_DDR_NUM_CHANNELS)
+		return -EINVAL;
+
+	do {
+		ret = k3_phy_wait_mailbox(ddr, channel, false);
+		if (ret)
+			return ret;
+
+		message = k3_phy_read(ddr, channel, K3_PHY_UCT_WRITE_ONLY_SHADOW);
+		message_id = message & 0xff;
+
+		ret = k3_phy_ack_message(ddr, channel);
+		if (ret)
+			return ret;
+
+		if (message_id != K3_PHY_MSG_STREAM)
+			continue;
+
+		ret = k3_phy_wait_mailbox(ddr, channel, false);
+		if (ret)
+			return ret;
+
+		count = k3_phy_read(ddr, channel, K3_PHY_UCT_WRITE_ONLY_SHADOW);
+
+		ret = k3_phy_ack_message(ddr, channel);
+		if (ret)
+			return ret;
+
+		for (i = 0; i < count; i++) {
+			ret = k3_phy_wait_mailbox(ddr, channel, false);
+			if (ret)
+				return ret;
+
+			ret = k3_phy_ack_message(ddr, channel);
+			if (ret)
+				return ret;
+		}
+	} while (message_id != K3_PHY_MSG_COMPLETE && message_id != K3_PHY_MSG_ERROR);
+
+	return message_id == K3_PHY_MSG_COMPLETE ? 0 : -EIO;
+}
