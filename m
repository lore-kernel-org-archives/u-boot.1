+
+    if (iret !=3D 0) {
+        TEST_ASSERT(oret =3D=3D 0);
+    }
+
+    TEST_LE_S(0, nb_int);
+    size_t nb =3D nb_int;
+
+    unsigned char buf[1024];
+    TEST_LE_U(nb, sizeof(buf));
+
+    /* nx_32_int is the number of 32 bit limbs, if we have 64 bit limbs we=
 need
+     * to halve the number of limbs to have the same size. */
+    size_t nx;
+    TEST_LE_S(0, nx_32_int);
+    if (sizeof(mbedtls_mpi_uint) =3D=3D 8) {
+        nx =3D nx_32_int / 2 + nx_32_int % 2;
+    } else {
+        nx =3D nx_32_int;
+    }
+
+    mbedtls_mpi_uint X[sizeof(buf) / sizeof(mbedtls_mpi_uint)];
+    TEST_LE_U(nx, sizeof(X) / sizeof(X[0]));
+
+    int endian;
+    if (iendian =3D=3D MBEDTLS_MPI_MOD_EXT_REP_INVALID) {
+        endian =3D MBEDTLS_MPI_MOD_EXT_REP_LE;
+    } else {
+        endian =3D iendian;
+    }
+
+    mbedtls_mpi_uint init[sizeof(X) / sizeof(X[0])];
+    memset(init, 0xFF, sizeof(init));
+    int ret =3D mbedtls_mpi_mod_modulus_setup(&m, init, nx);
+    TEST_EQUAL(ret, 0);
+
+    if (iendian =3D=3D MBEDTLS_MPI_MOD_EXT_REP_INVALID && iret !=3D 0) {
+        endian =3D MBEDTLS_MPI_MOD_EXT_REP_INVALID;
+    }
+
+    ret =3D mbedtls_mpi_mod_raw_read(X, &m, input->x, input->len, endian);
+    TEST_EQUAL(ret, iret);
+
+    if (iret =3D=3D 0) {
+        if (iendian =3D=3D MBEDTLS_MPI_MOD_EXT_REP_INVALID && oret !=3D 0)=
 {
+            endian =3D MBEDTLS_MPI_MOD_EXT_REP_INVALID;
+        }
+
+        ret =3D mbedtls_mpi_mod_raw_write(X, &m, buf, nb, endian);
+        TEST_EQUAL(ret, oret);
+    }
+
