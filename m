sandbox_spl does not enable CONFIG_SPL_GZIP, so load_simple_fit() has
no gzip coverage either.

Enable it and add FIT_INTERNAL_GZIP and FIT_EXTERNAL_GZIP the same way
as the LZMA and zstd pairs, registered for the NOR loader.

The blob is generate_data() output for the seed "gzip", compressed
with:

  gzip -9n -c plain.bin    (gzip 1.14)

-n keeps the timestamp and file name out of the header so the blob is
reproducible.

Signed-off-by: Cole Munz <Munzzyy1@proton.me>
---
 configs/sandbox_spl_defconfig |   1 +
 include/test/spl.h            |  10 +
 test/image/spl_load.c         | 361 ++++++++++++++++++++++++++++++++++
 test/image/spl_load_nor.c     |   2 +
 4 files changed, 374 insertions(+)

diff --git a/configs/sandbox_spl_defconfig b/configs/sandbox_spl_defconfig
index 135edd41835c..5b9b3e8c0e98 100644
--- a/configs/sandbox_spl_defconfig
+++ b/configs/sandbox_spl_defconfig
@@ -230,6 +230,7 @@ CONFIG_RSA_VERIFY_WITH_PKEY=3Dy
 CONFIG_TPM=3Dy
 CONFIG_ZSTD=3Dy
 CONFIG_SPL_LZMA=3Dy
+CONFIG_SPL_GZIP=3Dy
 CONFIG_SPL_ZSTD=3Dy
 CONFIG_ERRNO_STR=3Dy
 CONFIG_SPL_HEXDUMP=3Dy
diff --git a/include/test/spl.h b/include/test/spl.h
index 4f66c2da9823..9d02cda60a61 100644
--- a/include/test/spl.h
+++ b/include/test/spl.h
@@ -32,9 +32,11 @@ void generate_data(char *data, size_t size, const char *=
test_name);
  * @FIT_INTERNAL: FITs with internal data
  * @FIT_INTERNAL_LZMA: FITs with internal data, LZMA compressed
  * @FIT_INTERNAL_ZSTD: FITs with internal data, Zstandard compressed
+ * @FIT_INTERNAL_GZIP: FITs with internal data, gzip compressed
  * @FIT_EXTERNAL: FITs with external data
  * @FIT_EXTERNAL_LZMA: FITs with external data, LZMA compressed
  * @FIT_EXTERNAL_ZSTD: FITs with external data, Zstandard compressed
+ * @FIT_EXTERNAL_GZIP: FITs with external data, gzip compressed
  */
 enum spl_test_image {
 =09LEGACY,
@@ -43,9 +45,11 @@ enum spl_test_image {
 =09FIT_INTERNAL,
 =09FIT_INTERNAL_LZMA,
 =09FIT_INTERNAL_ZSTD,
+=09FIT_INTERNAL_GZIP,
 =09FIT_EXTERNAL,
 =09FIT_EXTERNAL_LZMA,
 =09FIT_EXTERNAL_ZSTD,
+=09FIT_EXTERNAL_GZIP,
 };
=20
 /**
@@ -94,6 +98,8 @@ extern const char lzma_compressed[];
 extern const size_t lzma_compressed_size;
 extern const char zstd_compressed[];
 extern const size_t zstd_compressed_size;
+extern const char gzip_compressed[];
+extern const size_t gzip_compressed_size;
=20
 /**
  * typedef write_image_t - Callback for writing an image
@@ -145,6 +151,10 @@ static inline bool image_supported(enum spl_test_image=
 type)
 =09case FIT_EXTERNAL_ZSTD:
 =09=09return IS_ENABLED(CONFIG_SPL_ZSTD) &&
 =09=09       IS_ENABLED(CONFIG_SPL_LOAD_FIT);
+=09case FIT_INTERNAL_GZIP:
+=09case FIT_EXTERNAL_GZIP:
+=09=09return IS_ENABLED(CONFIG_SPL_GZIP) &&
+=09=09       IS_ENABLED(CONFIG_SPL_LOAD_FIT);
 =09case FIT_INTERNAL_LZMA:
 =09case FIT_EXTERNAL_LZMA:
 =09=09if (!IS_ENABLED(CONFIG_SPL_LZMA))
