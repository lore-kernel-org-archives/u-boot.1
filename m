+/* BEGIN_CASE */
+void persistent_key_destroy(int owner_id_arg, int key_id_arg, int restart,
+                            int first_type_arg, data_t *first_data,
+                            int second_type_arg, data_t *second_data)
+{
+    mbedtls_svc_key_id_t key_id =3D
+        mbedtls_svc_key_id_make(owner_id_arg, key_id_arg);
+    mbedtls_svc_key_id_t returned_key_id =3D MBEDTLS_SVC_KEY_ID_INIT;
+    psa_key_type_t first_type =3D (psa_key_type_t) first_type_arg;
+    psa_key_type_t second_type =3D (psa_key_type_t) second_type_arg;
+    psa_key_attributes_t attributes =3D PSA_KEY_ATTRIBUTES_INIT;
+
+    PSA_ASSERT(psa_crypto_init());
+
+    psa_set_key_id(&attributes, key_id);
+    psa_set_key_type(&attributes, first_type);
+
+    PSA_ASSERT(psa_import_key(&attributes, first_data->x, first_data->len,
+                              &returned_key_id));
+
+    if (restart) {
+        psa_close_key(key_id);
+        PSA_DONE();
+        PSA_ASSERT(psa_crypto_init());
+    }
+    TEST_EQUAL(psa_is_key_present_in_storage(key_id), 1);
+
+    /* Destroy the key */
+    PSA_ASSERT(psa_destroy_key(key_id));
+
+    /* Check key slot storage is removed */
+    TEST_EQUAL(psa_is_key_present_in_storage(key_id), 0);
+
+    /* Shutdown and restart */
+    PSA_DONE();
+    PSA_ASSERT(psa_crypto_init());
+
+    /* Create another key in the same slot */
+    psa_set_key_id(&attributes, key_id);
+    psa_set_key_type(&attributes, second_type);
+    PSA_ASSERT(psa_import_key(&attributes, second_data->x, second_data->le=
n,
+                              &returned_key_id));
+
+    PSA_ASSERT(psa_destroy_key(key_id));
+
+exit:
+    PSA_DONE();
+    psa_destroy_persistent_key(key_id);
+}
+/* END_CASE */
