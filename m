+                                         output1, sizeof(output1)));
+    PSA_DONE();
+
+    /* Second round */
+    PSA_ASSERT(psa_crypto_init());
+    TEST_EQUAL(0, mbedtls_psa_get_random(MBEDTLS_PSA_RANDOM_STATE,
+                                         output2, sizeof(output2)));
+    PSA_DONE();
+
+    /* The two rounds must generate different random data. */
