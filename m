+    DRIVER_ASSERT_RETURN(*pubkey_length =3D=3D 0);
+    if (!PSA_KEY_TYPE_IS_KEY_PAIR(psa_get_key_type(attributes))) {
+        DRIVER_ASSERT_RETURN(pubkey =3D=3D NULL);
+        DRIVER_ASSERT_RETURN(pubkey_size =3D=3D 0);
+    }
