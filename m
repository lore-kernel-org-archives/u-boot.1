+static psa_status_t ram_import(psa_drv_se_context_t *context,
+                               psa_key_slot_number_t slot_number,
+                               const psa_key_attributes_t *attributes,
+                               const uint8_t *data,
+                               size_t data_length,
+                               size_t *bits)
+{
+    psa_key_type_t type =3D psa_get_key_type(attributes);
+    psa_status_t status =3D ram_create_common(context, slot_number, attrib=
utes,
+                                            data_length);
+    if (status !=3D PSA_SUCCESS) {
+        return status;
+    }
