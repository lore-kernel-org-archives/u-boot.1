+void persistent_slot_lifecycle(int lifetime_arg, int owner_id_arg, int id_=
arg,
+                               int usage_arg, int alg_arg, int alg2_arg,
+                               int type_arg, data_t *key_data,
+                               int invalidate_method_arg)
+{
+    psa_key_lifetime_t lifetime =3D lifetime_arg;
+    mbedtls_svc_key_id_t id =3D mbedtls_svc_key_id_make(owner_id_arg, id_a=
rg);
