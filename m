-	.align 4
-
-wait_interrupt:
-#ifdef ICCICR
-	ldr     r1, =ICCICR
-	mov     r2, #0x0
-	str     r2, [r1]
-	mov     r2, #0xF0
-	adds    r1, r1, #4 /* ICCPMR */
-	str     r2, [r1]
-	ldr     r1, =ICCICR
-	mov     r2, #0x1
-	str     r2, [r1]
-#endif
