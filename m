+
+    int ret;
+    int num_records =3D 16;
+    mbedtls_ssl_context ssl; /* ONLY for debugging */
+
+    mbedtls_ssl_transform t0, t1;
+    unsigned char *buf =3D NULL;
+    size_t const buflen =3D 512;
+    mbedtls_record rec, rec_backup;
+
