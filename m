-        sig = commit.committer
-        val = hashlib.sha1()
-        to_hash = f'{sig.name} <{sig.email}> {sig.time} {sig.offset}'
-        val.update(to_hash.encode('utf-8'))
-        val.update(str(commit.tree_id).encode('utf-8'))
-        val.update(commit.message.encode('utf-8'))
-        return val.hexdigest()
