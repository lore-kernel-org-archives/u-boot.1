 =09case FIT_INTERNAL_LZMA:
 =09case FIT_EXTERNAL_LZMA:
 =09=09return "lzma";
+=09case FIT_INTERNAL_ZSTD:
+=09case FIT_EXTERNAL_ZSTD:
+=09=09return "zstd";
