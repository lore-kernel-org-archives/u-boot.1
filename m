+            memcpy(B.p, A.p, bytes);    /* restore B from equal value A */
+        }
+
+        /* The output may be aliased to B - last test, so we don't save B =
*/
+
+        mbedtls_mpi_core_montmul(B.p, A.p, B.p, B.n, N.p, N.n, mm, T.p);
