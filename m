+void copy_across_lifetimes(int source_lifetime_arg, int source_owner_id_ar=
g,
+                           int source_id_arg, int source_usage_arg,
+                           int source_alg_arg, int source_alg2_arg,
+                           int type_arg, data_t *material,
+                           int target_lifetime_arg, int target_owner_id_ar=
g,
+                           int target_id_arg, int target_usage_arg,
+                           int target_alg_arg, int target_alg2_arg,
+                           int expected_usage_arg,
+                           int expected_alg_arg, int expected_alg2_arg)
+{
+    psa_key_lifetime_t source_lifetime =3D source_lifetime_arg;
+    mbedtls_svc_key_id_t source_id =3D
+        mbedtls_svc_key_id_make(source_owner_id_arg, source_id_arg);
+    psa_key_usage_t source_usage =3D source_usage_arg;
+    psa_algorithm_t source_alg =3D source_alg_arg;
+    psa_key_attributes_t source_attributes =3D PSA_KEY_ATTRIBUTES_INIT;
+    psa_key_type_t source_type =3D type_arg;
+    mbedtls_svc_key_id_t returned_source_id =3D MBEDTLS_SVC_KEY_ID_INIT;
+    psa_key_lifetime_t target_lifetime =3D target_lifetime_arg;
+    mbedtls_svc_key_id_t target_id =3D
+        mbedtls_svc_key_id_make(target_owner_id_arg, target_id_arg);
+    psa_key_usage_t target_usage =3D target_usage_arg;
+    psa_algorithm_t target_alg =3D target_alg_arg;
+    psa_key_attributes_t target_attributes =3D PSA_KEY_ATTRIBUTES_INIT;
+    mbedtls_svc_key_id_t returned_target_id =3D MBEDTLS_SVC_KEY_ID_INIT;
+    psa_key_handle_t target_handle =3D PSA_KEY_HANDLE_INIT;
+    psa_key_usage_t expected_usage =3D expected_usage_arg;
+    psa_algorithm_t expected_alg =3D expected_alg_arg;
+    psa_algorithm_t expected_alg2 =3D expected_alg2_arg;
+    uint8_t *export_buffer =3D NULL;
+
+    TEST_USES_KEY_ID(source_id);
+    TEST_USES_KEY_ID(target_id);
+
+    PSA_ASSERT(psa_crypto_init());
+
+    /* Populate the source slot. */
+    psa_set_key_id(&source_attributes, source_id);
+    psa_set_key_lifetime(&source_attributes, source_lifetime);
+
+    psa_set_key_type(&source_attributes, source_type);
+    psa_set_key_usage_flags(&source_attributes, source_usage);
+    psa_set_key_algorithm(&source_attributes, source_alg);
+    psa_set_key_enrollment_algorithm(&source_attributes, source_alg2_arg);
+    PSA_ASSERT(psa_import_key(&source_attributes,
+                              material->x, material->len,
+                              &returned_source_id));
+    /* Update the attributes with the bit size. */
+    PSA_ASSERT(psa_get_key_attributes(returned_source_id,
+                                      &source_attributes));
+
+    /* Prepare the target slot. */
+    psa_set_key_id(&target_attributes, target_id);
+    psa_set_key_lifetime(&target_attributes, target_lifetime);
+
+    psa_set_key_usage_flags(&target_attributes, target_usage);
+    psa_set_key_algorithm(&target_attributes, target_alg);
+    psa_set_key_enrollment_algorithm(&target_attributes, target_alg2_arg);
