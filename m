+void mpi_mod_setup(int int_rep, int iret)
+{
+    #define MLIMBS 8
+    mbedtls_mpi_uint mp[MLIMBS];
+    mbedtls_mpi_mod_modulus m;
+    int ret;
+
+    memset(mp, 0xFF, sizeof(mp));
+
+    mbedtls_mpi_mod_modulus_init(&m);
+
+    switch (int_rep) {
+        case MBEDTLS_MPI_MOD_REP_MONTGOMERY:
+            ret =3D mbedtls_mpi_mod_modulus_setup(&m, mp, MLIMBS);
+            break;
+        case MBEDTLS_MPI_MOD_REP_OPT_RED:
+            ret =3D mbedtls_mpi_mod_optred_modulus_setup(&m, mp, MLIMBS, N=
ULL);
+            break;
+        default:
+            ret =3D MBEDTLS_ERR_MPI_BAD_INPUT_DATA;
+            break;
+    }
+
+    TEST_EQUAL(ret, iret);
+
+    /* Only test if the constants have been set-up  */
+    if (ret =3D=3D 0 && int_rep =3D=3D MBEDTLS_MPI_MOD_REP_MONTGOMERY) {
+        /* Test that the consts have been calculated */
+        TEST_ASSERT(m.rep.mont.rr !=3D NULL);
+        TEST_ASSERT(m.rep.mont.mm !=3D 0);
+
+    }
+
+    /* Address sanitiser should catch if we try to free mp */
+    mbedtls_mpi_mod_modulus_free(&m);
+
+    /* Make sure that the modulus doesn't have reference to mp anymore */
+    TEST_ASSERT(m.p !=3D mp);
+
+    /* Only test if the constants have been set-up  */
+    if (ret =3D=3D 0 && int_rep =3D=3D MBEDTLS_MPI_MOD_REP_MONTGOMERY) {
+        /* Verify the data and pointers allocated have been properly wiped=
 */
+        TEST_ASSERT(m.rep.mont.rr =3D=3D NULL);
+        TEST_ASSERT(m.rep.mont.mm =3D=3D 0);
+    }
+exit:
+    /* It should be safe to call an mbedtls free several times */
+    mbedtls_mpi_mod_modulus_free(&m);
+
+    #undef MLIMBS
+}
